{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fHund3D/R0192-Roboticarm/doku/schemas/program.schema.json",
  "title": "R0192 Program",
  "description": "Sequential robot program for the R0192 arm (programs/program_*.yaml), executed by r0192_program_executor via the /execute_program action. Steps reference points from points.yaml by name. Source of truth for the runtime loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "steps"],
  "properties": {
    "version": {
      "const": 1,
      "description": "Schema version (currently always 1)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the program."
    },
    "description": {
      "type": "string",
      "description": "Optional free-text description."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default scaling factors for steps that do not set their own (fallback if absent: 0.1).",
      "properties": {
        "velocity": { "$ref": "#/definitions/scaling" },
        "acceleration": { "$ref": "#/definitions/scaling" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of steps, executed sequentially.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/ptp" },
          { "$ref": "#/definitions/lin" },
          { "$ref": "#/definitions/circ" },
          { "$ref": "#/definitions/moveJ" },
          { "$ref": "#/definitions/moveL" },
          { "$ref": "#/definitions/wait" }
        ]
      }
    }
  },
  "definitions": {
    "scaling": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "MoveIt scaling factor in (0, 1] — NOT a physical velocity. Physical units come with the Pilz planner (plan phase 7)."
    },
    "pointName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Name of a point defined in points.yaml."
    },
    "stepName": {
      "type": "string",
      "description": "Optional display name shown in the RViz Program Panel."
    },
    "blendRadius": {
      "type": "number",
      "minimum": 0,
      "description": "c_dis — blend/approximation radius in metres (0 = stop exactly at the point). KRL Continuous-Distance. Only effective once the Pilz sequence mode lands; currently logged and ignored (sequential stop-at-point)."
    },
    "ptp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "description": "Point-to-point joint move via the Pilz planner (KRL PTP). Accepts a joint- or pose-type point. Successor of move_j.",
      "properties": {
        "type": { "const": "ptp" },
        "name": { "$ref": "#/definitions/stepName" },
        "target": { "$ref": "#/definitions/pointName" },
        "vel": { "$ref": "#/definitions/scaling" },
        "acc": { "$ref": "#/definitions/scaling" },
        "c_dis": { "$ref": "#/definitions/blendRadius" }
      }
    },
    "lin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "description": "Linear Cartesian move via the Pilz planner (KRL LIN). Requires a pose-type point. Cannot pass the joint_5 = 0 wrist singularity. Successor of move_l.",
      "properties": {
        "type": { "const": "lin" },
        "name": { "$ref": "#/definitions/stepName" },
        "target": { "$ref": "#/definitions/pointName" },
        "vel": { "$ref": "#/definitions/scaling" },
        "acc": { "$ref": "#/definitions/scaling" },
        "c_dis": { "$ref": "#/definitions/blendRadius" }
      }
    },
    "circ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "via"],
      "description": "Circular Cartesian move via the Pilz planner (KRL CIRC): an arc through the via (auxiliary) point to the target. Both must be pose-type. Executor support arrives with the Pilz sequence mode.",
      "properties": {
        "type": { "const": "circ" },
        "name": { "$ref": "#/definitions/stepName" },
        "target": { "$ref": "#/definitions/pointName" },
        "via": { "$ref": "#/definitions/pointName" },
        "vel": { "$ref": "#/definitions/scaling" },
        "acc": { "$ref": "#/definitions/scaling" },
        "c_dis": { "$ref": "#/definitions/blendRadius" }
      }
    },
    "moveJ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "description": "DEPRECATED — prefer ptp. Joint-space move (OMPL) to a named point (joint- or pose-type). Kept for backward compatibility.",
      "properties": {
        "type": { "const": "move_j" },
        "name": { "$ref": "#/definitions/stepName" },
        "target": { "$ref": "#/definitions/pointName" },
        "velocity": { "$ref": "#/definitions/scaling" },
        "acceleration": { "$ref": "#/definitions/scaling" }
      }
    },
    "moveL": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "description": "DEPRECATED — prefer lin. Linear Cartesian move (KDL computeCartesianPath) to a named pose-type point. Kept for backward compatibility.",
      "properties": {
        "type": { "const": "move_l" },
        "name": { "$ref": "#/definitions/stepName" },
        "target": { "$ref": "#/definitions/pointName" },
        "velocity": { "$ref": "#/definitions/scaling" },
        "acceleration": { "$ref": "#/definitions/scaling" }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration"],
      "description": "Pause program execution.",
      "properties": {
        "type": { "const": "wait" },
        "name": { "$ref": "#/definitions/stepName" },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds."
        }
      }
    }
  }
}
