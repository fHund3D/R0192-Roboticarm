<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r0192_hardware</name>
  <version>0.0.0</version>
  <description>ROS 2 hardware interface plugin for the R0192 6-DOF robotic arm</description>
  <maintainer email="nils@todo.todo">nils</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>r0192_canbus</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/r0192_hardware_plugin.xml"/>
  </export>
</package>
