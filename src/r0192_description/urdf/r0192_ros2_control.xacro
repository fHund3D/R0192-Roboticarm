<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r0192">

    <ros2_control name="RobotSystem" type="system">

        <!-- Simulation (Gazebo Iron / ROS 2 Iron+) -->
        <xacro:if value="$(arg is_sim)">
            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
            <!-- Gripper mimic for simulation -->
            <joint name="joint_8">
                <param name="mimic">joint_7</param>
                <param name="multiplier">-1</param>
                <command_interface name="position"/>
                <state_interface name="position"/>
            </joint>
        </xacro:if>

        <!-- Real robot: r0192_hardware plugin via SocketCAN -->
        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>r0192_hardware/R0192SystemHardware</plugin>
            </hardware>
            <!-- joint_8: passive mimic of joint_7, state only -->
            <joint name="joint_8">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </xacro:unless>

        <!-- Arm joints 1-6 (same for sim and real) -->
        <!-- kp / kd: MIT-Control gains, read by R0192SystemHardware::on_init().
             Only joints with real motors (joint_1, joint_4) use these at runtime;
             passthrough joints ignore them. -->
        <joint name="joint_1">
            <param name="kp">50.0</param>
            <param name="kd">1.0</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_2">
            <param name="kp">0.0</param>
            <param name="kd">0.0</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_3">
            <param name="kp">0.0</param>
            <param name="kd">0.0</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_4">
            <param name="kp">30.0</param>
            <param name="kd">0.5</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_5">
            <param name="kp">0.0</param>
            <param name="kd">0.0</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_6">
            <param name="kp">0.0</param>
            <param name="kd">0.0</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- Gripper (joint_7 active, joint_8 passive mimic defined above) -->
        <joint name="joint_7">
            <param name="kp">0.0</param>
            <param name="kd">0.0</param>
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>

</robot>
