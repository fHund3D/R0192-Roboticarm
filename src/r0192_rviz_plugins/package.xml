<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r0192_rviz_plugins</name>
  <version>0.0.1</version>
  <description>
    RViz 2 operator panel for the R0192 arm: buttons to trigger the homing
    sequence (/homing) and to switch the motors on/off (/robot_enable).
    Debug/convenience tool — productive operation is the planned r0192_remote
    web interface.
  </description>
  <maintainer email="anbraten_giesser_3b@icloud.com">fHund3D</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>qtbase5-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
