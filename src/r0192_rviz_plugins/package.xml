<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r0192_rviz_plugins</name>
  <version>0.0.1</version>
  <description>
    RViz 2 panels for the R0192 arm: JogPanel (teach-pendant + operator
    controls via the central state machine), ProgramPanel (runtime-only
    program run panel for the /execute_program action) and the legacy
    OperatorPanel.
  </description>
  <maintainer email="anbraten_giesser_3b@icloud.com">fHund3D</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>r0192_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>qtbase5-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
