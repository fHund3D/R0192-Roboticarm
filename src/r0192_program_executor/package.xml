<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r0192_program_executor</name>
  <version>0.0.0</version>
  <description>
    Program executor backend for the R0192 arm: loads YAML programs/points
    (programs/*.yaml, points.yaml), executes them step by step via
    MoveGroupInterface and exposes the /execute_program action. State is
    managed exclusively through /set_robot_state (robot_state_manager).
  </description>
  <maintainer email="anbraten_giesser_3b@icloud.com">fHund3D</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>r0192_interfaces</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
